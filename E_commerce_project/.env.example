# MongoDB Connection (Required)
# Use your MongoDB Atlas connection string or local MongoDB URL
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/database?retryWrites=true&w=majority

# Server Configuration
PORT=5050

# JWT Configuration (Required)
JWT_KEY=your_jwt_secret_key_here
JWT_EXPIRE_TIME=2592000

# Email Configuration
EMAIL_HOST=mail.example.com
EMAIL_PORT=25
EMAIL_SECURITY=false
EMAIL_USER=info@example.com
EMAIL_PASS=your_email_password
EMAIL_UN_AUTH=false

# Application Settings
WEB_CACHE=false
MAX_JSON_SIZE=10MB
URL_ENCODE=true
REQUEST_TIME=1200000
REQUEST_NUMBER=2000

# Payment Gateway (SSL Commerz)
STORE_ID=your_store_id
STORE_PASSWORD=your_store_password
CURRENCY=BDT
SUCCESS_URL=
FAIL_URL=
CANCEL_URL=
INIT_URL=
