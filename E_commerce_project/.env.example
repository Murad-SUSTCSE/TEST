# Server Configuration
PORT=5050

# MongoDB Configuration
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/MernEcommerce?retryWrites=true&w=majority

# JWT Configuration
JWT_KEY=your-secret-jwt-key-here
JWT_EXPIRE_TIME=2592000

# Email Configuration
EMAIL_HOST=mail.example.com
EMAIL_PORT=25
EMAIL_SECURITY=false
EMAIL_USER=info@example.com
EMAIL_PASS=your-email-password
EMAIL_UN_AUTH=false

# Cache Configuration
WEB_CACHE=false
MAX_JSON_SIZE=10MB
URL_ENCODE=true

# Rate Limiting
REQUEST_TIME=1200000
REQUEST_NUMBER=2000

# Payment Configuration (SSLCommerz or other payment gateway)
STORE_ID=your-store-id
STORE_PASSWORD=your-store-password
CURRENCY=BDT
SUCCESS_URL=
FAIL_URL=
CANCEL_URL=
INIT_URL=
